{
  "summary": "An app's sidebar: a workspace switcher, grouped links with badges and the signed-in user's menu at the bottom.",
  "props": [
    {
      "name": "groups",
      "type": "none",
      "typeName": "SidebarGroup[]",
      "description": "The navigation, in groups."
    },
    {
      "name": "current",
      "type": "string",
      "default": "#files",
      "description": "The `href` of the page shown first, marked as current until a link is picked."
    },
    {
      "name": "onNavigate",
      "type": "none",
      "typeName": "(href: string) => void",
      "description": "Called with a link's `href` when it is picked."
    },
    {
      "name": "user",
      "type": "none",
      "typeName": "{ name: string; email: string }",
      "description": "Who is signed in, shown at the bottom with their menu."
    },
    {
      "name": "brand",
      "type": "none",
      "typeName": "{ name: string; logo?: ReactNode }",
      "description": "The app's name and mark at the top."
    },
    {
      "name": "onSearch",
      "type": "none",
      "typeName": "(query: string) => void",
      "description": "Called with the text typed into the search field."
    },
    {
      "name": "accounts",
      "type": "none",
      "typeName": "SidebarAccount[]",
      "description": "Every account the switcher in the user menu lists, the signed-in one included."
    },
    {
      "name": "onAccountChange",
      "type": "none",
      "typeName": "(email: string) => void",
      "description": "Called with an account's email when it is picked from the switcher."
    },
    {
      "name": "onAddAccount",
      "type": "none",
      "typeName": "() => void",
      "description": "Called when Add account is picked from the switcher."
    },
    {
      "name": "status",
      "type": "enum",
      "values": [
        "online",
        "busy",
        "offline"
      ],
      "default": "online",
      "description": "The user's status, shown on their avatar and picked from their menu.",
      "controlled": true,
      "handler": "onStatusChange"
    },
    {
      "name": "onStatusChange",
      "type": "none",
      "typeName": "(status: SidebarStatus) => void",
      "description": "Called with the status picked from the user menu."
    },
    {
      "name": "onSignOut",
      "type": "none",
      "typeName": "() => void",
      "description": "Called when Sign out is picked from the user menu."
    },
    {
      "name": "shape",
      "type": "enum",
      "values": [
        "square",
        "rounded",
        "squircle",
        "pill"
      ],
      "default": "rounded",
      "description": "Corner radius of the links, menus, badges & avatar. Inherits the nearest `Shape`."
    },
    {
      "name": "container",
      "type": "none",
      "typeName": "HTMLElement | null",
      "description": "Where the menus are portalled. Leave unset to portal into `document.body`; pass an element to keep them inside a scrolling frame."
    }
  ],
  "scene": [
    {
      "tag": "div",
      "className": "d:f w:100% h:100%",
      "children": [
        {
          "component": "Sidebar",
          "props": {
            "brand": {
              "name": "Drive",
              "logo": {
                "$icon": "IconCloud",
                "size": "w:4 h:4"
              }
            },
            "groups": [
              {
                "links": [
                  {
                    "label": "Home",
                    "href": "#home",
                    "icon": {
                      "$icon": "IconHome",
                      "size": "w:4 h:4"
                    }
                  },
                  {
                    "label": "My files",
                    "href": "#files",
                    "icon": {
                      "$icon": "IconFolder",
                      "size": "w:4 h:4"
                    }
                  },
                  {
                    "label": "Photos",
                    "href": "#photos",
                    "icon": {
                      "$icon": "IconPhoto",
                      "size": "w:4 h:4"
                    }
                  },
                  {
                    "label": "Starred",
                    "href": "#starred",
                    "icon": {
                      "$icon": "IconStar",
                      "size": "w:4 h:4"
                    }
                  }
                ]
              },
              {
                "label": "Sharing",
                "links": [
                  {
                    "label": "Shared with me",
                    "href": "#shared",
                    "icon": {
                      "$icon": "IconShare",
                      "size": "w:4 h:4"
                    },
                    "badge": 3
                  },
                  {
                    "label": "People",
                    "href": "#people",
                    "icon": {
                      "$icon": "IconUsers",
                      "size": "w:4 h:4"
                    }
                  }
                ]
              },
              {
                "links": [
                  {
                    "label": "Trash",
                    "href": "#trash",
                    "icon": {
                      "$icon": "IconTrash",
                      "size": "w:4 h:4"
                    }
                  },
                  {
                    "label": "Settings",
                    "href": "#settings",
                    "icon": {
                      "$icon": "IconSettings",
                      "size": "w:4 h:4"
                    }
                  }
                ]
              }
            ],
            "current": "#files",
            "user": {
              "name": "Ada Lovelace",
              "email": "ada@yummaui.com"
            }
          }
        },
        {
          "tag": "div",
          "className": "d:f f:1 ai:c jc:c m:4 bw:2 bs:d bc:rim c:hint fs:sm us:none",
          "children": [
            {
              "text": "Page content"
            }
          ]
        }
      ]
    }
  ]
}
