{
  "summary": "A raised panel with a heading and anything under it.",
  "props": [
    {
      "name": "title",
      "type": "string",
      "example": "Monthly revenue",
      "description": "The heading at the top."
    },
    {
      "name": "description",
      "type": "string",
      "example": "Across every plan, after refunds.",
      "description": "A line under the title."
    },
    {
      "name": "children",
      "type": "none",
      "typeName": "ReactNode",
      "description": "What the card holds under the heading, buttons included."
    },
    {
      "name": "shape",
      "type": "enum",
      "values": [
        "square",
        "rounded",
        "squircle",
        "pill"
      ],
      "default": "rounded",
      "description": "Corner radius of the card. Inherits the nearest `Shape`."
    },
    {
      "name": "className",
      "type": "string",
      "description": "Extra classes. `merge` folds them in last, so one here replaces the component's own class for the same utility."
    }
  ],
  "scene": [
    {
      "component": "Card",
      "className": "w:88 max-w:100%",
      "props": {
        "title": "Monthly revenue",
        "description": "Across every plan, after refunds."
      },
      "children": [
        {
          "tag": "div",
          "className": "d:f ai:b g:2",
          "children": [
            {
              "text": "$48,210",
              "className": "fs:3xl fw:600 fvn:tn"
            },
            {
              "text": "+12.4%",
              "className": "c:green-6 fs:sm fw:500"
            }
          ]
        },
        {
          "tag": "div",
          "className": "d:f fw:w jc:fe g:2",
          "children": [
            {
              "component": "Button",
              "props": {
                "variant": "secondary",
                "size": "sm"
              },
              "children": "Export"
            },
            {
              "component": "Button",
              "props": {
                "size": "sm"
              },
              "children": "View report"
            }
          ]
        }
      ]
    }
  ]
}
